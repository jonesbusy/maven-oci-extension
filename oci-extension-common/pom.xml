<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cloud.jonesbusy</groupId>
        <artifactId>oci-extension-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>oci-extension-common</artifactId>
    <packaging>jar</packaging>

    <description>
        Maven-coordinate to OCI-registry mapping used by oci-extension-core for both resolve and
        publish: repository/tag naming, the annotation scheme used to identify layers/referrers, and
        media-type mapping. Has no dependency on Aether.
    </description>

    <dependencies>
        <dependency>
            <groupId>land.oras</groupId>
            <artifactId>oras-java-sdk</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
