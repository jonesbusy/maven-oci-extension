<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>multi-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <modules>
        <module>module-a</module>
        <module>module-b</module>
    </modules>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!--
        Points mvn deploy's own deploy phase at njord for local staging. The publisher's actual push
        target is supplied separately via -DaltReleaseDeploymentRepository=... at invocation time,
        since njord's PublisherConfigSupport gives -DaltDeploymentRepository priority over everything
        else when building a publisher's own target repository: if it were reused here for both, the
        deploy publisher would try to push to "njord:" itself instead of the real URL.
    -->
    <distributionManagement>
        <repository>
            <id>my-oci</id>
            <url>njord:</url>
        </repository>
    </distributionManagement>

</project>
